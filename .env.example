# Firebase config — get these from Firebase Console > Project Settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Required to create Admin / Developer accounts. Leave blank only for open admin signup.
VITE_ADMIN_SIGNUP_CODE=

# EmailJS — get these from emailjs.com dashboard
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Due amount (in your currency) above which a reminder email is triggered
VITE_DUE_ALERT_THRESHOLD=2000
