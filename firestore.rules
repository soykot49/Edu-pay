rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isAdmin();
    }

    match /students/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isAdmin() ||
        (isOwner(uid) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email']));
    }

    match /transactions/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if isAdmin() ||
        (isSignedIn() &&
         request.resource.data.studentUid == request.auth.uid &&
         request.resource.data.type == 'payment' &&
         request.resource.data.status == 'pending' &&
         request.resource.data.amount is number &&
         request.resource.data.amount > 0);
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt']) &&
        (request.resource.data.status == 'confirmed' || request.resource.data.status == 'pending');
    }

    match /notifications/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read is bool;
      allow create: if isSignedIn() &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.kind == 'payment_pending' &&
        request.resource.data.read == false;
    }

    match /costs/{id} {
      allow read, write: if isAdmin();
    }
  }
}
