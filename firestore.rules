rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isAdmin();
    }

    match /students/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isAdmin() || isOwner(uid); // student totals are also updated via student-submitted claims
    }

    match /transactions/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.studentUid == request.auth.uid && request.resource.data.type == 'payment' && request.resource.data.status == 'pending');
      allow update: if isAdmin();
    }

    match /notifications/{id} {
      allow read, update: if isAdmin();
      allow create: if isSignedIn();
    }

    match /costs/{id} {
      allow read, write: if isAdmin();
    }
  }
}
